! --- do not touch Mod3 ---
clear Mod1
clear Mod3
clear Mod4

! left/right swaps (adjust keycodes if yours differ)
keycode 133 = Alt_L
keycode 134 = Alt_R
keycode 64  = Super_L
keycode 108 = Super_R

add Mod3 = Alt_L Alt_R
add Mod1 = Super_L Super_R

! Escape -> Caps Lock (reverse direction only; Caps -> Escape is now set
! natively via `setxkbmap -option caps:escape` in keyboard_setup.sh so it's
! visible to XKB-aware apps like Chromium/Electron/Obsidian, which xmodmap
! can't reach). keycode 9 is the physical Escape key on all standard layouts.
keycode 9 = Caps_Lock
add Lock = Caps_Lock
