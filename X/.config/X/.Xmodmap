! --- do not touch Mod3 ---
clear Mod1
clear Mod3
clear Mod4

! left/right swaps (adjust keycodes if yours differ)
keycode 133 = Alt_L
keycode 134 = Alt_R
keycode 64  = Super_L
keycode 108 = Super_R

add Mod1 = Alt_L Alt_R
add Mod3 = Super_L Super_R

! your Caps/Esc swap
remove Lock = Caps_Lock
keysym Caps_Lock = Escape
keysym Escape    = Caps_Lock
add Lock = Caps_Lock
